# Browser-safe public Supabase values.
# Put real values in your hosting provider env vars or a local .env.local file.
# Never put SUPABASE_SERVICE_ROLE_KEY in frontend env.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SUPABASE_STORAGE_BUCKET=candidate-files
